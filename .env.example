# ============================================
# Environment Variables - Production Example
# ============================================
# Copy this file to .env.local and fill in actual values

# === APPLICATION ===
NEXT_PUBLIC_SITE_URL=https://yan-si.io

# === TELEGRAM BOT ===
# Get from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Get from @userinfobot (https://t.me/userinfobot)
TELEGRAM_CHAT_ID=your_chat_id_here
# Optional: Reply to specific thread in group
TELEGRAM_THREAD_ID=

# === RATE LIMITING ===
# Maximum form submissions per IP per time window
RATE_LIMIT_REQUESTS=3
# Time window in milliseconds (3600000 = 1 hour)
RATE_LIMIT_WINDOW_MS=3600000

# === SECURITY ===
# Enable honeypot spam protection
ENABLE_HONEYPOT=true
# Enable IP validation
ENABLE_IP_VALIDATION=true

# === LOGGING ===
# Log level: debug, info, warn, error
LOG_LEVEL=info
# Enable request logging
ENABLE_REQUEST_LOGGING=true
# Enable Telegram logging
ENABLE_TELEGRAM_LOGGING=true

# === ANALYTICS ===
# Google Analytics ID (optional)
NEXT_PUBLIC_GA_ID=
# Google Tag Manager ID (optional)
NEXT_PUBLIC_GTAG_ID=

# === DEVELOPMENT ONLY ===
# Set to true in development for verbose logging
NODE_ENV=production
